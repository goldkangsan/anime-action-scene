   "outputs": [],
   "source": [
    "# ── 5. 참조 이미지 업로드 ──────────────────────────────────────────────────────\n",
    "import shutil\n",
    "from google.colab import files\n",
    "\n",
    "uploaded = files.upload()  # 캐릭터 이미지 업로드\n",
    "for fname in uploaded:\n",
    "    shutil.copy(fname, 'inputs/ref.png')\n",
    "    print(f'저장됨: inputs/ref.png')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
